#<src>                                     <mnt_point>     <type>  <mnt_flags and options>                                             <fs_mgr_flags>

# normal mounts
/dev/block/platform/soc.0/f9824900.sdhci/by-name/system       /system         ext4    ro,barrier=1,noatime,user_xattr,discard                                      wait
/dev/block/platform/soc.0/f9824900.sdhci/by-name/cache        /cache          f2fs    rw,nosuid,nodev,noatime,nodiratime,inline_xattr,discard                      wait
/dev/block/platform/soc.0/f9824900.sdhci/by-name/modem        /firmware       vfat    ro,uid=1000,gid=1026,dmask=227,fmask=337                                     wait
/dev/block/platform/soc.0/f9824900.sdhci/by-name/persist      /persist        ext4    nosuid,nodev,barrier=1,data=ordered,nodelalloc,errors=panic,user_xattr       wait,notrim

# late mounts
# note: f2fs will not mount with errors=panic and/or barrier=1
/dev/block/platform/soc.0/f9824900.sdhci/by-name/userdata     /data           f2fs    noatime,nosuid,nodev,nodiratime,inline_xattr,discard                           wait,encryptable=/dev/block/platform/soc.0/f9824900.sdhci/by-name/encrypt,latemount
/dev/block/platform/soc.0/f9824900.sdhci/by-name/userdata     /data           ext4    noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered     wait,encryptable=/dev/block/platform/soc.0/f9824900.sdhci/by-name/encrypt,latemount

# vold managed (sdcard)
/devices/soc.0/f98a4900.sdhci/mmc_host*    auto        auto    defaults        voldmanaged=sdcard1:auto,encryptable=/dev/block/platform/soc.0/f9824900.sdhci/by-name/encrypt
/devices/soc.0/f9200000.ssusb/f9200000.dwc3/xhci-hcd.0.auto/usb*        auto        auto    defaults        voldmanaged=usb:auto
